# dev → S3 keys under food/; production → no extra prefix
ENVIRONMENT=dev

# Local Docker: docker compose up db  →  mysql://root:12345678@localhost:3306/restropro_saas
DATABASE_URL="mysql://root:12345678@localhost:3306/restropro_saas"
JWT_SECRET=kadesh_jwt_secret
JWT_EXPIRY=15m
JWT_EXPIRY_REFRESH=30d

# provide in ms - milliseconds => 15 minute, 30days | match the value to JWT expiry
COOKIE_EXPIRY=300000
COOKIE_EXPIRY_REFRESH=2592000000

PASSWORD_SALT=10
FRONTEND_DOMAIN="http://localhost:5173" # For Development: http://localhost:5173 # For Production: https://mydomain.com
FRONTEND_DOMAIN_COOKIE="localhost" # For Development: localhost # For Production: mydomain.com

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=

ENCRYPTION_KEY=uiflow


# Asset storage (menu items, store image). Use s3 in production.
STORAGE_DRIVER=s3
AWS_REGION=us-east-1
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# CloudFront or S3 public URL base (no trailing slash)
ASSETS_PUBLIC_BASE_URL=https://your-cdn.example.com

#Just for local docker
MYSQL_ROOT_PASSWORD=12345678
MYSQL_DATABASE=restropro_saas

DB_HOST=localhost
DB_PORT=3306
